{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hylo (Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/hylo_flutter",
      "program": "${workspaceFolder}/hylo_flutter/lib/main.dart",
      "args": ["-d", "chrome", "--web-port=8080"]
    },
    {
      "name": "Hylo (iOS)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/hylo_flutter",
      "program": "${workspaceFolder}/hylo_flutter/lib/main.dart",
      "args": ["-d", "ios"]
    },
    {
      "name": "Hylo (Android)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/hylo_flutter",
      "program": "${workspaceFolder}/hylo_flutter/lib/main.dart",
      "args": ["-d", "android"]
    }
  ]
}
