{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start CORS Proxy",
      "type": "shell",
      "command": "node proxy/server.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Hylo CORS proxy",
          "endsPattern": "Forwarding"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "hylo"
      }
    }
  ]
}
